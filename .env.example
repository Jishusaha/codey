# Supabase (required for auth + project storage)
# These are public values safe to commit — they end up in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# AI provider for the chat/builder feature (pick one)
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GOOGLE_MODEL=gemini-2.0-flash
# OR use OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key

# Vercel deploy feature (optional — needed for one-click deploy)
VERCEL_API_TOKEN=your-vercel-api-token
